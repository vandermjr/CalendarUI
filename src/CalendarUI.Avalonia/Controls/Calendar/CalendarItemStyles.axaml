<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CalendarUI.Avalonia.Controls.Calendar"
        xmlns:converters="using:CalendarUI.Avalonia.Converters">

    <Styles.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </Styles.Resources>

    <Style Selector="local|CalendarItemControl">
        <Setter Property="Template">
            <ControlTemplate TargetType="local:CalendarItemControl" x:DataType="local:ICalendarItem">
                <Grid ClipToBounds="False">
                    <Border x:Name="PART_ItemBorder"
                            Margin="2,1"
                            CornerRadius="3"
                            ClipToBounds="True"
                            Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}"
                            BorderBrush="{DynamicResource CalendarBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource CalendarItemShadow}"
                            ToolTip.ShowDelay="200">

                        <!-- ToolTip -->
                        <ToolTip.Tip>
                            <Border CornerRadius="8"
                                    Background="{DynamicResource CalendarSurfaceBrush}"
                                    BorderBrush="{DynamicResource CalendarBorderBrush}"
                                    BorderThickness="1"
                                    Padding="12,10"
                                    BoxShadow="{DynamicResource CalendarTooltipShadow}"
                                    MaxWidth="300">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Title}"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        Foreground="{DynamicResource CalendarTextPrimaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Text}"
                                            FontSize="11"
                                            Foreground="{DynamicResource CalendarTextSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <Separator Background="{DynamicResource CalendarGridLineBrush}" Height="1" Margin="0,2" />

                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Text="Período:"
                                                FontWeight="SemiBold"
                                                FontSize="11"
                                                Foreground="{DynamicResource CalendarTextSecondaryBrush}"
                                                Margin="0,0,8,0" />

                                        <TextBlock Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource CalendarTextPrimaryBrush}"
                                                TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:dd/MM/yyyy (dddd)} → {1:dd/MM/yyyy (dddd)}">
                                                    <Binding Path="DateStart" />
                                                    <Binding Path="DateEnd" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Text="Horário:"
                                                FontWeight="SemiBold"
                                                FontSize="11"
                                                Foreground="{DynamicResource CalendarTextSecondaryBrush}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource CalendarTextPrimaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:HH:mm} às {1:HH:mm}">
                                                    <Binding Path="DateStart" />
                                                    <Binding Path="DateEnd" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ToolTip.Tip>

                        <!-- Conteúdo do Card -->
                        <Grid Margin="12,2,4,2">
                            <TextBlock Grid.Row="0"
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Foreground="{Binding ForeColor, Converter={StaticResource ColorToBrushConverter}}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                TextAlignment="Center"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- Continuidade pela esquerda: cavidade -->
                    <Path x:Name="PART_SegmentStartTopCut"
                        Data="M 0,0 L 0,16 L 12,16 Z"
                        Width="12"
                        Height="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="2,1"
                        Fill="{DynamicResource CalendarSurfaceBrush}"
                        IsHitTestVisible="False"
                        IsVisible="False" />

                    <Path x:Name="PART_SegmentStartBottomCut"
                        Data="M 0,16 L 0,0 L 12,0 Z"
                        Width="12"
                        Height="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="2,1"
                        Fill="{DynamicResource CalendarSurfaceBrush}"
                        IsHitTestVisible="False"
                        IsVisible="False" />

                    <!-- Continuidade pela direita: ponta -->
                    <Path x:Name="PART_SegmentEndTopCut"
                        Data="M 0,0 L 12,0 L 12,16 Z"
                        Width="12"
                        Height="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="2,1"
                        Fill="{DynamicResource CalendarSurfaceBrush}"
                        IsHitTestVisible="False"
                        IsVisible="False" />

                    <Path x:Name="PART_SegmentEndBottomCut"
                        Data="M 0,16 L 12,16 L 12,0 Z"
                        Width="12"
                        Height="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="2,1"
                        Fill="{DynamicResource CalendarSurfaceBrush}"
                        IsHitTestVisible="False"
                        IsVisible="False" />

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="local|CalendarItemControl:segment-continues-from-previous Path#PART_SegmentStartTopCut">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="local|CalendarItemControl:segment-continues-from-previous Path#PART_SegmentStartBottomCut">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="local|CalendarItemControl:segment-continues-to-next Path#PART_SegmentEndTopCut">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="local|CalendarItemControl:segment-continues-to-next Path#PART_SegmentEndBottomCut">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="local|CalendarItemControl:segment-continues-from-previous Border#PART_ItemBorder">
        <Setter Property="BorderThickness" Value="0,1,1,1" />
    </Style>

    <Style Selector="local|CalendarItemControl:segment-continues-to-next Border#PART_ItemBorder">
        <Setter Property="BorderThickness" Value="1,1,0,1" />
    </Style>

    <Style Selector="local|CalendarItemControl:segment-continues-from-previous:segment-continues-to-next Border#PART_ItemBorder">
        <Setter Property="BorderThickness" Value="0,1,0,1" />
    </Style>

</Styles>
