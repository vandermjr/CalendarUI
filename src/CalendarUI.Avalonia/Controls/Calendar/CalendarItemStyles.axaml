<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CalendarUI.Avalonia.Controls.Calendar"
        xmlns:converters="using:CalendarUI.Avalonia.Converters">

    <Styles.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </Styles.Resources>

    <Style Selector="local|CalendarItemControl">
        <Setter Property="Template">
            <ControlTemplate TargetType="local:CalendarItemControl" x:DataType="local:ICalendarItem">
                <Border Margin="2,1"
                        CornerRadius="3"
                        ClipToBounds="True"
                        Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}"
                        BorderBrush="{DynamicResource CalendarBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="{DynamicResource CalendarItemShadow}"
                        ToolTip.ShowDelay="200">

                    <!-- ToolTip -->
                    <ToolTip.Tip>
                        <Border CornerRadius="8"
                                Background="{DynamicResource CalendarSurfaceBrush}"
                                BorderBrush="{DynamicResource CalendarBorderBrush}"
                                BorderThickness="1"
                                Padding="12,10"
                                BoxShadow="{DynamicResource CalendarTooltipShadow}"
                                MaxWidth="300">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Text}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource CalendarTextPrimaryBrush}"
                                           TextWrapping="Wrap" />

                                <Separator Background="{DynamicResource CalendarGridLineBrush}" Height="1" Margin="0,2" />

                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Text="Data:" 
                                               FontWeight="SemiBold" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource CalendarTextSecondaryBrush}" 
                                               Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding DateStart, StringFormat='{}{0:dd/MM/yyyy (dddd)}'}"
                                               FontSize="11" 
                                               Foreground="{DynamicResource CalendarTextPrimaryBrush}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Text="Horário:" 
                                               FontWeight="SemiBold" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource CalendarTextSecondaryBrush}" 
                                               Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource CalendarTextPrimaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:HH:mm} às {1:HH:mm}">
                                                <Binding Path="DateStart" />
                                                <Binding Path="DateEnd" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ToolTip.Tip>

                    <!-- Conteúdo do Card -->
                    <Grid ColumnDefinitions="14, *">
                        <!-- Indicador de continuidade: só aparece quando parte do evento está fora da grade visível. -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
                            <Path x:Name="PART_ContinuesBefore"
                                Grid.Row="0"
                                Data="M 2,8 L 7,2 L 12,8"
                                Width="12"
                                Height="12"
                                Stroke="White"
                                StrokeThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False"
                                Fill="{DynamicResource CalendarItemVisibilityWarningBrush}" />

                            <Path x:Name="PART_ContinuesAfter"
                                Grid.Row="2"
                                Data="M 2,2 L 7,8 L 12,2"
                                Width="12"
                                Height="12"
                                Stroke="White"
                                StrokeThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False"
                                Fill="{DynamicResource CalendarItemVisibilityWarningBrush}" />
                        </Grid>

                        <!-- Título do Compromisso -->
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Text}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{Binding ForeColor, Converter={StaticResource ColorToBrushConverter}}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" 
                                   Margin="4,1,4,1"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="local|CalendarItemControl:continues-before Path#PART_ContinuesBefore">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="local|CalendarItemControl:continues-after Path#PART_ContinuesAfter">
        <Setter Property="IsVisible" Value="True" />
    </Style>

</Styles>
