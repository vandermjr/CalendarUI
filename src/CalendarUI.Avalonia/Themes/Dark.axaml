<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fundo Geral da Aplicação / Grade -->
    <SolidColorBrush x:Key="CalendarBackgroundBrush" Color="#121212" />
    
    <!-- Réguas de Horas e Cabeçalho de Semanas -->
    <SolidColorBrush x:Key="CalendarHeaderBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="CalendarHeaderBorderBrush" Color="#2E2E2E" />
    
    <!-- Fundo de Cartões / Superfície -->
    <SolidColorBrush x:Key="CalendarSurfaceBrush" Color="#1E1E1E" />
    
    <!-- Linhas da Grade do Calendário -->
    <SolidColorBrush x:Key="CalendarGridLineBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="CalendarBorderBrush" Color="#333333" />

    <!-- Textos e Botões -->
    <SolidColorBrush x:Key="CalendarTextPrimaryBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="CalendarTextSecondaryBrush" Color="#8E8E8E" />
    <SolidColorBrush x:Key="CalendarButtonHoverBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="CalendarButtonPressedBrush" Color="#383838" />

    <!-- Destaque do Dia Atual -->
    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#8AB4F8" />
    <SolidColorBrush x:Key="CalendarTodayForegroundBrush" Color="#121212" />

    <!-- Cores dos Itens e Cards -->
    <SolidColorBrush x:Key="CalendarItemAccentStripBrush" Color="#8AB4F8" />
    <BoxShadows x:Key="CalendarItemShadow">0 1 2 0 #40000000</BoxShadows>
    <BoxShadows x:Key="CalendarTooltipShadow">0 4 12 0 #80000000</BoxShadows>

    <!-- MonthView / Mini-Calendar -->
    <SolidColorBrush x:Key="MonthViewTodayBackgroundBrush" Color="#8AB4F8" />
    <SolidColorBrush x:Key="MonthViewTodayForegroundBrush" Color="#121212" />

    <SolidColorBrush x:Key="MonthViewSelectionCurrentMonthBrush" Color="#004A77" />
    <SolidColorBrush x:Key="MonthViewSelectionOtherMonthBrush" Color="#2A2A2A" />

    <SolidColorBrush x:Key="MonthViewTextPrimaryBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="MonthViewTextSecondaryBrush" Color="#757575" />
</ResourceDictionary>