<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <MergeResourceInclude x:Key="Light" Source="avares://CalendarUI.Avalonia/Themes/Light.axaml" />
                <MergeResourceInclude x:Key="Dark" Source="avares://CalendarUI.Avalonia/Themes/Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://CalendarUI.Avalonia/Controls/Calendar/CalendarStyles.axaml" />
    <StyleInclude Source="avares://CalendarUI.Avalonia/Controls/Calendar/CalendarItemStyles.axaml" />
    <StyleInclude Source="avares://CalendarUI.Avalonia/Controls/MonthView/MonthViewStyles.axaml" />
</Styles>