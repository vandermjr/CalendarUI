<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalendarUI.Demo.App"
             RequestedThemeVariant="Light">
    
    <Application.Styles>
        <FluentTheme />
        <!-- Carrega os estilos e temas que vêm DENTRO do pacote do Calendário -->
        <StyleInclude Source="avares://CalendarUI.Avalonia/Themes/Index.axaml" />
    </Application.Styles>
</Application>
